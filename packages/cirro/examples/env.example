CIRRO_HOST=127.0.0.1
CIRRO_PORT=3977
CIRRO_DATA_DIR=/var/lib/cirro
CIRRO_API_TOKEN=change-me
CIRRO_READ_TOKEN=
CIRRO_WORKER_CONCURRENCY=1
CIRRO_MAX_QUEUED_RUNS=100
CIRRO_ALLOW_LOCAL_SOURCES=false
CIRRO_ALLOWED_LOCAL_SOURCE_ROOTS=
CIRRO_ALLOWED_GIT_HOSTS=github.com
CIRRO_ALTO_PROVIDER=github-copilot
CIRRO_ALTO_MODEL=gpt-5.4
CIRRO_WORKSPACE_ROOT=/var/lib/cirro/workspaces
CIRRO_DEFAULT_STEP_LIMIT=20
CIRRO_DEFAULT_TIMEOUT_MS=30000
