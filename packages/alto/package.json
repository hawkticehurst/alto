{
  "name": "alto",
  "version": "0.1.0",
  "description": "A tiny coding agent meant for the cloud.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "import": "./dist/src/core/index.js"
    },
    "./models": {
      "types": "./dist/src/models/index.d.ts",
      "import": "./dist/src/models/index.js"
    },
    "./environments": {
      "types": "./dist/src/environments/index.d.ts",
      "import": "./dist/src/environments/index.js"
    },
    "./events": {
      "types": "./dist/src/runs/events.d.ts",
      "import": "./dist/src/runs/events.js"
    },
    "./runs": {
      "types": "./dist/src/runs/index.d.ts",
      "import": "./dist/src/runs/index.js"
    },
    "./auth/github-copilot": {
      "types": "./dist/src/auth/github-copilot.d.ts",
      "import": "./dist/src/auth/github-copilot.js"
    },
    "./auth/openrouter": {
      "types": "./dist/src/auth/openrouter-api-key.d.ts",
      "import": "./dist/src/auth/openrouter-api-key.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "import": "./dist/src/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "alto": "./dist/src/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "agent",
    "coding-agent",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "dotenv": "^16.4.7",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
